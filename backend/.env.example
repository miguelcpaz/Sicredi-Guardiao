# Sicredi Guardião V2 — Environment variables
# Copy this file to .env and fill in the values before running the backend.
# NEVER commit .env to version control — it contains secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Sicredi Guardião V2"
DEBUG=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (SQLite — no setup required):
# DATABASE_URL=sqlite:///./guardiao_v2.db

# Neon PostgreSQL (production — obtain from https://neon.tech free tier):
DATABASE_URL=jdbc:postgresql://ep-muddy-frost-b6cr0su6-pooler.c-2.sa-east-1.aws.neon.tech/neondb?user=neondb_owner&password=npg_nbBa0mENK9JR&sslmode=require&channelBinding=require

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# AI Provider — Google Gemini (primary, free tier)
# ---------------------------------------------------------------------------
# Options: gemini | mock | groq | ollama
# "gemini" → Google Gemini API (free tier, recommended)
# "mock"   → no network calls; deterministic responses (safe for tests)
# "groq"   → Groq API (optional fallback, requires GROQ_API_KEY)
# "ollama" → local Ollama inference (optional, requires separate install)
AI_PROVIDER=gemini

# Google Gemini — FREE TIER
# 1. Visit https://aistudio.google.com/apikey
# 2. Create API key (no billing required)
# 3. Set here (NEVER hardcode in source)
GEMINI_API_KEY=AQ.Ab8RN6Ir62O-qvQeFcg6elJkzungB7m3iyAFa8LJmcjknH1KUA
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024
# Safety limit: max AI calls per session (prevents quota exhaustion)
GEMINI_MAX_CALLS_PER_SESSION=50

# Groq (optional fallback — https://console.groq.com — free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=15

# Ollama (optional local inference — https://ollama.com)
# Run: ollama pull llama3.2:3b && ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# CORS (frontend origins allowed)
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
