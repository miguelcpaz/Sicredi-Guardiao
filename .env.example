# Sicredi Guardião V2 — Configuração de Ambiente
# Copie este arquivo para backend/.env e ajuste os valores conforme necessário.
# NUNCA commite o arquivo .env no repositório — ele contém segredos.

# ============================================================
# Aplicação
# ============================================================
APP_NAME="Sicredi Guardião V2"
APP_VERSION="2.0.0"
DEBUG=false

# ============================================================
# Banco de Dados
# ============================================================
# Local (SQLite — sem instalação necessária):
DATABASE_URL=sqlite:///./guardiao_v2.db

# Neon PostgreSQL (produção — camada gratuita em https://neon.tech):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================
# Segurança / JWT
# Gere: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
SECRET_KEY=change-me-in-production-use-a-long-random-string-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================
# Provedor de IA — Groq (principal, camada gratuita)
# Valores: "groq" | "mock" | "gemini" | "ollama"
# - groq:   API Groq (recomendado — sem custo, baixa latência)
# - mock:   respostas simuladas (testes, sem rede)
# - gemini: API Google Gemini (alternativa opcional, requer GEMINI_API_KEY)
# - ollama: inferência local (requer instalação separada)
# ============================================================
AI_PROVIDER=groq

# Groq — PROVEDOR PRINCIPAL — CAMADA GRATUITA
# 1. Acesse https://console.groq.com
# 2. Crie uma API key (sem cobrança)
# 3. Configure aqui (NUNCA hardcode no código)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=15

# Google Gemini (alternativa opcional — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_CALLS_PER_SESSION=50

# Ollama (inferência local — https://ollama.com)
# Execute: ollama pull llama3.2:3b && ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# ============================================================
# CORS — origens permitidas para o frontend
# ============================================================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
